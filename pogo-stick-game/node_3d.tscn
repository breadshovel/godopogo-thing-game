[sub_resource type="GDScript" id="GDScript_4vnpt"]
resource_name = "CameraPivot"
script/source = "extends Node3D

#variables
@onready var player_body = $\"..\"
var camera_ypos: float

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	
	camera_ypos = 0 - player_body.position.y + .5 # subtracts player pos from relative camera pivot pos, basically keeping it in the same place
	position.y = camera_ypos # applies to position
"

