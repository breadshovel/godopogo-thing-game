[sub_resource type="GDScript" id="GDScript_5t8nk"]
script/source = "extends Node

const ENEMY = preload(\"res://enemy.tscn\")

var enemy_amount := 0
var game_start = false


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	enemy_amount = get_child_count()
	print(enemy_amount)
	if enemy_amount == 0 and game_start:
		next_wave()
	#print(enemy_amount)
	#print($\"..\".game_start)
	#print(game_start)
	#print(round(2 ^ ($\"..\".wave - 1)))


func _on_start_game_timer_timeout() -> void:
	game_start = true
	#use math to get exponential amount of enemy growth from wave
	var enemy_spawn_count = ceil(1.5 ** ($\"..\".wave))
	
	for i in range(enemy_spawn_count):
		var enemy_clone = ENEMY.instantiate() # Replace with function body.
		add_child(enemy_clone)
		enemy_clone.position = Vector3(randf_range(-12.324, 67.0),3,randf_range(-59.235, 59.167))
		print(\"hoi\") # Replace with function body.
		
func next_wave() -> void:
	$\"..\".wave += 1
	$\"../Player\"._ready()
	
	$\"..\".start()
	game_start = false
	$\"../CanvasLayer/GAME START SCREEN\".visible = true
	$\"../CanvasLayer/GAME START SCREEN/Label3\".visible = false
	
"

