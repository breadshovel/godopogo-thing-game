[sub_resource type="GDScript" id="GDScript_ype4i"]
script/source = "extends Node2D

var title_sequence = [
	preload(\"res://Textures/title_sequence/titlesequence1.png\"),
	preload(\"res://Textures/title_sequence/titlesequence2.png\"),
	preload(\"res://Textures/title_sequence/titlesequence3.png\"),
	preload(\"res://Textures/title_sequence/titlesequence4.png\"),
	preload(\"res://Textures/title_sequence/titlescreen.png\"),
]

var current_frame = 0
var opacity: float

func _process(delta: float) -> void:
	print(opacity)
	if current_frame < 4: opacity += 1.4 * delta
	$TitlescreenFadeOverlay.modulate.a = round(opacity * 7.5) / 7.5

#func title_sequence():
#	pass #$TitlescreenBackground.
	


func _on_bpm_timer_timeout() -> void:
	if current_frame < 4:
		current_frame += 1
		$TitlescreenBackground.texture = title_sequence[current_frame]
	else:
		$PlayButton.visible = true
	$BPM_Timer.start(1.846)
	opacity = 0


func _on_start_timer_timeout() -> void:
	$BPM_Timer.start(1.846)
	$TitlescreenBackground.texture = title_sequence[current_frame]
	$StartTimer.stop()
	opacity = 0
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
